<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- Device icon -->
    <ImageView
        android:id="@+id/img_ping_device"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="Device type" />

    <!-- Name + time stacked -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_ping_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ping_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- RSSI -->
    <TextView
        android:id="@+id/tv_ping_rssi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="@color/text_data"
        android:layout_marginEnd="10dp" />

    <TextView
        android:id="@+id/tv_ping_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="@color/text_data"
        android:layout_marginEnd="10dp"
        android:minWidth="60dp"
        android:gravity="end" />

    <!-- Direct / Indirect badge -->
    <TextView
        android:id="@+id/tv_ping_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:textColor="@color/accent"
        android:letterSpacing="0.08" />

</LinearLayout>
