<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_bar_container"
    android:layout_width="match_parent"
    android:layout_height="28dp"
    android:minHeight="28dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@color/secondary_background"
    android:gravity="center_vertical"
    android:elevation="2dp">

    <!-- Frequency Text -->
    <TextView
        android:id="@+id/tv_frequency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="                  "
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:letterSpacing="0.02"
        android:singleLine="true"
        android:ellipsize="end"
        android:maxWidth="140dp"    />

    <!-- Spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <!-- Temperature -->
    <TextView
        android:id="@+id/tv_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="11.5sp"
        android:textColor="@color/color_blue"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="100.0°" />

    <!-- Signal Quality Icon -->
    <ImageView
        android:id="@+id/icon_signal"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/antenna_red"
        android:scaleType="fitCenter"
        android:contentDescription="Signal Quality" />

    <!-- MC Icon (shown when net != "BC") -->
    <ImageView
        android:id="@+id/icon_mc"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/meshcore"
        android:contentDescription="MeshCore Mode"
        android:visibility="gone" />   <!-- hidden by default -->

    <!-- Stealth Level Icon -->
    <ImageView
        android:id="@+id/icon_stealth"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/stealth_disabled"
        android:contentDescription="Stealth Mode" />

    <!-- GPS Fix Icon -->
    <ImageView
        android:id="@+id/icon_gps"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/gps_disabled"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:padding="1dp"
        android:contentDescription="GPS Status" />

    <!-- battery level -->
    <ImageView
        android:id="@+id/icon_battery"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/battery_unknown"
        android:scaleType="centerInside"
        android:padding="1dp"
        android:contentDescription="Battery Level"
        />

</LinearLayout>