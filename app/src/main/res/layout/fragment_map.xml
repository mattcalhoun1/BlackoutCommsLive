<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- OSMDroid Map (fills entire frame, under everything) -->
    <org.osmdroid.views.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Cluster label — top-left -->
    <TextView
        android:id="@+id/tv_cluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:text="Cluster: loading..."
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:background="@drawable/bg_semi_dark"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp" />

    <!-- Top-right checkbox strip: Critical + Mesh Graph -->
    <LinearLayout
        android:id="@+id/top_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:layout_margin="10dp">

        <CheckBox
            android:id="@+id/checkbox_critical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Critical"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:buttonTint="@color/accent"
            android:background="@drawable/bg_semi_dark"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:checked="false"
            android:layout_marginBottom="6dp" />

        <CheckBox
            android:id="@+id/checkbox_mesh_graph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mesh Graph"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:buttonTint="@color/accent"
            android:background="@drawable/bg_semi_dark"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:checked="false" />

    </LinearLayout>

    <!-- Recenter button — bottom-left corner, above the filter bar -->
    <ImageButton
        android:id="@+id/btn_recenter"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="82dp"
        android:src="@drawable/ic_recenter"
        android:background="@drawable/bg_semi_dark"
        android:padding="8dp"
        android:contentDescription="Re-center map on self" />

    <!-- Status + filter bar stacked together at the bottom -->
    <LinearLayout
        android:id="@+id/bottom_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/message_panel_bg">

        <!-- Status line -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:ellipsize="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_max_age"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Age: All Time"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeColor="@color/accent"
            app:backgroundTint="@color/surface_filter_btn"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_devices"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Devices: All"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeColor="@color/accent"
            app:backgroundTint="@color/surface_filter_btn"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_map_layer"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="ESRI Topo"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeColor="@color/accent"
            app:backgroundTint="@color/surface_filter_btn" />

        </LinearLayout>
    </LinearLayout>

    <!-- Message panel (slides up over the filter bar when messages arrive) -->
    <LinearLayout
        android:id="@+id/message_panel"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/message_panel_bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Messages"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_dismiss_messages"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Dismiss messages"
                android:tint="@color/text_secondary" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="4dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>

</FrameLayout>
