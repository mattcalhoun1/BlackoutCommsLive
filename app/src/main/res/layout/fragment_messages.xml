<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Controls row: device filter spinner + newest-first checkbox -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <!-- Device filter label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="6dp" />

        <!-- Device filter spinner -->
        <Spinner
            android:id="@+id/spinner_device"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/accent"
            android:popupBackground="@color/surface" />

        <!-- Newest first checkbox -->
        <CheckBox
            android:id="@+id/checkbox_newest_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Newest First"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:buttonTint="@color/accent"
            android:layout_marginStart="12dp"
            android:checked="true" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tv_empty_messages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No messages"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <!-- Messages list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Send buttons at bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_dm"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Send DM"
            android:layout_marginEnd="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:backgroundTint="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_broadcast"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Send Broadcast"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:backgroundTint="@color/accent" />

    </LinearLayout>

</LinearLayout>
